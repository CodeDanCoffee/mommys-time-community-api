# Copy to .env and fill in. Everything has a working default for local dev.

# The iOS app's bundle identifier — the Apple identity token's `aud` must match.
APPLE_BUNDLE_ID=com.codedancoffee.mommys-time

# Secret used to sign OUR session tokens. MUST be changed for production.
JWT_SECRET=change-me-to-a-long-random-string

# How long a session token stays valid.
SESSION_DAYS=60

# Database. SQLite by default; swap for Postgres in production, e.g.
# DATABASE_URL=postgresql://user:pass@host:5432/community
DATABASE_URL=sqlite:///./community.db

# DEV ONLY. When true, /auth/apple accepts a raw `dev_apple_sub` instead of a
# real Apple identity token, so you can test the API without the iOS app.
# NEVER enable this in production.
ALLOW_DEV_LOGIN=false
